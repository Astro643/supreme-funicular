{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/api" }],
  "functions": {
    "api/[[...path]].mjs": {
      "maxDuration": 60,
      "includeFiles": "{app/**,public/**,node_modules/**}"
    }
  }
}
